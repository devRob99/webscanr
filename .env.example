# WebScan environment configuration.
# Copy to .env and fill in locally. NEVER commit .env.

# --- Live mode -------------------------------------------------------------
# Live queries are OFF by default. Turning this on is not enough by itself:
# each external provider must also be listed in "approved_providers" in
# config/providers.json, and the organization must have approved it in writing.
WEBSCAN_LIVE_MODE=false

# --- HackerTarget ----------------------------------------------------------
# Sent as the "apikey" query parameter. Leave empty to stay on mock data.
HACKERTARGET_API_KEY=

# --- Optional paths (defaults shown) ----------------------------------------
# WEBSCAN_CONFIG_DIR=config
# WEBSCAN_OUTPUT_DIR=output
# WEBSCAN_LOG_DIR=logs

# --- WIP third-party providers (all disabled unless approved) ---------------
# NVD CVE API (optional key raises the rate limit; sends CVE IDs only)
NVD_API_KEY=
# Have I Been Pwned (paid key required for the domain search API)
HIBP_API_KEY=
# Shodan
SHODAN_API_KEY=
# Google Safe Browsing / VirusTotal
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# GeoIP: path to a local MaxMind GeoLite2 database (nothing leaves the machine)
GEOIP_DB_PATH=data/reference/GeoLite2-City.mmdb
# Local LLM explanations: Ollama or LM Studio only, on this machine
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1

# --- Dashboard (optional later phase) ---------------------------------------
# Comma-separated token:role pairs, roles = admin | analyst | viewer
WEBSCAN_DASHBOARD_TOKENS=
